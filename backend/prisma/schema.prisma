generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  ACCOUNTANT
  STAFF
  VIEWER
}

enum RuleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED
}

enum ObligationStatus {
  UPCOMING
  DUE
  OVERDUE
  PAID
  SUBMITTED
  NOT_APPLICABLE
}

enum NotificationChannel {
  EMAIL
  PUSH
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentProvider {
  MPESA
  EMOLA
  SIMO
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum UploadStatus {
  RECEIVED
  RECONCILED
  DECIDED
  APPLIED
  FAILED
}

enum MatchState {
  MATCHED
  AMOUNT_MISMATCH
  UNMATCHED
  NOT_APPLICABLE
  DUPLICATE
  INVALID
}

enum RowDecision {
  PENDING
  ADOPT
  TRUST_RULE
  TRUST_UPLOAD
  EXCLUDE
  CREATE_TEMPLATE
  REJECT
}

model Tenant {
  id                  String                @id @default(uuid())
  name                String
  plan                String                @default("ACCOUNTANT_FREE")
  /// ACCOUNTANT (portfolio of clients) or COMPANY (single-empresa dashboard).
  type                String                @default("ACCOUNTANT")
  /// Declared annual revenue in MZN — drives the Empresas tier suggestion.
  annualRevenueMzn    Decimal?              @db.Decimal(18, 2)
  stripeCustomerId    String?               @unique
  createdAt           DateTime              @default(now())
  memberships         Membership[]
  companies           Company[]
  notificationSettings NotificationSetting[]
  simulations         Simulation[]
  payments            PaymentTransaction[]
  uploadBatches       UploadBatch[]
  billingSubscriptions BillingSubscription[]
  invoices            Invoice[]
}

model User {
  id          String      @id @default(uuid())
  cognitoSub  String      @unique
  email       String      @unique
  displayName String?
  phone       String?
  memberships Membership[]
}

model Membership {
  tenantId String
  userId   String
  role     MembershipRole
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  user     User   @relation(fields: [userId], references: [id])
  @@id([tenantId, userId])
}

model Company {
  id             String  @id @default(uuid())
  tenantId       String
  legalName      String
  nuitCiphertext Bytes?
  municipality   String?
  taxRegime      String?
  annualRevenueMzn Decimal? @db.Decimal(18, 2)
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  obligations    Obligation[]
  uploadBatches  UploadBatch[]
  @@index([tenantId])
}

model RuleSet {
  id            String     @id @default(uuid())
  code          String
  version       String
  status        RuleStatus
  effectiveFrom DateTime
  effectiveTo   DateTime?
  content       Json
  sourceUrl     String
  reviewer      String?
  approvedAt    DateTime?
  @@unique([code, version])
}

model Obligation {
  id             String           @id @default(uuid())
  tenantId       String
  companyId      String
  title          String
  dueAt          DateTime
  status         ObligationStatus @default(UPCOMING)
  ruleVersion    String
  sourceSnapshot Json
  createdAt      DateTime         @default(now())
  company        Company          @relation(fields: [companyId], references: [id])
  attempts       NotificationAttempt[]
  @@index([tenantId, dueAt])
  @@index([tenantId, status])
  @@index([dueAt])
}

model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String
  requestId  String
  occurredAt DateTime @default(now())
  before     Json?
  after      Json?
  @@index([tenantId, occurredAt])
}

model NotificationSetting {
  id       String              @id @default(uuid())
  tenantId String
  channel  NotificationChannel
  enabled  Boolean             @default(true)
  leadDays Int[]               @default([7, 3, 1, 0])
  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, channel])
}

model NotificationAttempt {
  id           String              @id @default(uuid())
  tenantId     String
  obligationId String
  channel      NotificationChannel
  leadDay      Int
  status       NotificationStatus  @default(PENDING)
  detail       String?
  createdAt    DateTime            @default(now())
  obligation   Obligation          @relation(fields: [obligationId], references: [id])
  @@unique([obligationId, channel, leadDay])
  @@index([tenantId, createdAt])
}

/// One client upload. A batch is the unit of idempotency: re-uploading identical bytes
/// is a no-op, and nothing here is trusted until it has been reconciled and decided.
model UploadBatch {
  id            String       @id @default(uuid())
  tenantId      String
  companyId     String
  fileName      String
  contentHash   String
  byteSize      Int
  status        UploadStatus @default(RECEIVED)
  rowCount      Int          @default(0)
  validCount    Int          @default(0)
  exceptionCount Int         @default(0)
  appliedAt     DateTime?
  createdBy     String?
  createdAt     DateTime     @default(now())
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  company       Company      @relation(fields: [companyId], references: [id])
  rows          StagingRow[]
  @@unique([tenantId, contentHash])
  @@index([tenantId, createdAt])
}

/// One CSV line, held in staging. A staging row can never become an Obligation on its
/// own: MatchState decides whether it is backed by an approved template, and RowDecision
/// records the human verdict. UNMATCHED rows become candidate RuleSet templates instead.
model StagingRow {
  id                 String          @id @default(uuid())
  uploadId           String
  tenantId           String
  rowNumber          Int
  raw                Json
  normalizedTitle    String?
  dueAt              DateTime?
  amount             Decimal?        @db.Decimal(14, 2)
  claimedStatus      ObligationStatus?
  ruleCode           String?
  matchState         MatchState      @default(INVALID)
  matchedTemplateCode String?
  expectedAmount     Decimal?        @db.Decimal(14, 2)
  decision           RowDecision     @default(PENDING)
  errors             Json?
  decidedBy          String?
  decidedAt          DateTime?
  createdAt          DateTime        @default(now())
  upload             UploadBatch     @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  @@unique([uploadId, rowNumber])
  @@index([uploadId, matchState])
  @@index([uploadId, dueAt])
  @@index([tenantId])
}

model Simulation {
  id           String   @id @default(uuid())
  tenantId     String
  companyId    String?
  code         String
  inputs       Json
  breakdown    Json
  total        String
  ruleVersions Json
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  @@index([tenantId, code, createdAt])
}

/// Stripe subscription that determines the tenant's plan. Written only by the
/// verified Stripe webhook, never directly by a client request.
model BillingSubscription {
  id                   String   @id @default(uuid())
  tenantId             String
  stripeCustomerId     String
  stripeSubscriptionId String   @unique
  status               String
  priceId              String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  @@index([stripeCustomerId])
}

model Invoice {
  id               String   @id @default(uuid())
  tenantId         String
  stripeInvoiceId  String   @unique
  amountDue        Decimal  @db.Decimal(12, 2)
  currency         String   @default("MZN")
  status           String
  invoicePdfUrl    String?
  hostedInvoiceUrl String?
  createdAt        DateTime @default(now())
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  @@index([tenantId, createdAt])
}

model PaymentTransaction {
  id               String          @id @default(uuid())
  tenantId         String
  provider         PaymentProvider
  externalId       String?
  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @default("MZN")
  status           PaymentStatus   @default(PENDING)
  customerPhone    String?
  customerEmail    String?
  description      String?
  metadata         Json?
  webhookVerified  Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  @@unique([provider, externalId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model LegalDocument {
  id          String   @id @default(uuid())
  title       String
  type        String
  sourceUrl   String?
  fullText    String
  effectiveAt DateTime?
  createdAt   DateTime @default(now())
  articles    LegalArticle[]
}

model LegalArticle {
  id              String   @id @default(uuid())
  documentId      String
  articleNumber   String
  title           String
  fullText        String
  embedding       Json?
  document        LegalDocument @relation(fields: [documentId], references: [id])
  @@index([documentId])
}

model ExchangeRateCache {
  id         String   @id @default(uuid())
  base       String
  target     String
  rate       Decimal  @db.Decimal(16, 6)
  source     String
  fetchedAt  DateTime @default(now())
  @@unique([base, target, source])
}

model NewsArticle {
  id          String   @id @default(uuid())
  title       String
  summary     String
  content     String
  category    String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
