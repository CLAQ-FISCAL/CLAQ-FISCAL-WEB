{
  "name": "claq-backend",
  "private": true,
  "version": "2.0.0",
  "description": "CLAQ Fiscal Alert — AWS Serverless Backend",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npx tsx watch src/local.ts",
    "build": "tsc --noEmit",
    "build:lambdas": "node scripts/build-lambdas.mjs",
    "lint": "eslint src infra scripts",
    "test": "vitest run",
    "test:security": "NODE_ENV=test npx tsx test/security.test.ts",
    "synth": "npm run build:lambdas && cdk synth",
    "deploy:demo": "npm run build:lambdas && cdk deploy --all --context env=demo --require-approval broadening",
    "deploy:prod": "npm run build:lambdas && cdk deploy --all --context env=prod --require-approval broadening",
    "db:generate": "prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "seed:demo": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.800.0",
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/client-secrets-manager": "^3.800.0",
    "@aws-sdk/client-sesv2": "^3.800.0",
    "@aws-sdk/client-sqs": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@prisma/client": "^6.10.0",
    "aws-jwt-verify": "^5.2.1",
    "bcrypt": "^5.1.1",
    "decimal.js": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "aws-cdk": "^2.0.0",
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.5",
    "eslint": "^9.30.0",
    "prisma": "^6.10.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.2"
  }
}
