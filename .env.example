# CLAQ Fiscal Alert - Environment Variables Template
# Copy to .env and replace all values before deploying

NODE_ENV=production
PORT=4000
APP_ENV=demo
FRONTEND_URL=https://app.claq.co.mz,http://localhost:5173

# Database (AWS RDS PostgreSQL 16 with pgvector)
POSTGRES_DB=claq_fiscal_alert
POSTGRES_USER=claq_admin
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_HERE
DATABASE_URL=postgresql://claq_admin:GENERATE_STRONG_RANDOM_PASSWORD_HERE@db:5432/claq_fiscal_alert?schema=public&sslmode=require&connection_limit=5

# AWS KMS (for NUIT encryption)
KMS_KEY_ID=your-kms-key-id-or-alias

# AWS S3 Documents Bucket
DOCUMENT_BUCKET=claq-fiscal-documents

# AWS SQS Notification Queue
NOTIFICATION_QUEUE=https://sqs.af-south-1.amazonaws.com/ACCOUNT_ID/claq-notifications

# Alert Email Source (SES)
ALERTS_FROM_EMAIL=alerts@claq.co.mz

# Cryptographic Keys
DIGITAL_SEAL_SECRET=GENERATE_64_CHAR_HEX_SEAL_SECRET_HERE
JWT_SECRET=GENERATE_64_CHAR_HEX_JWT_SECRET_HERE

# Google Single Sign-On (OAuth 2.0)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft Entra ID (Azure AD SSO)
MICROSOFT_CLIENT_ID=your-azure-app-id-guid
MICROSOFT_CLIENT_SECRET=your-azure-client-secret
MICROSOFT_TENANT_ID=your-azure-tenant-id

# Apple Sign-In
APPLE_CLIENT_ID=mz.co.claq.fiscal.client
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=/secrets/AuthKey_apple.p8

# AWS Cognito
COGNITO_USER_POOL_ID=af-south-1_xxxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp Business Cloud API (via AWS Secrets Manager)
WHATSAPP_SECRET_ARN=arn:aws:secretsmanager:af-south-1:ACCOUNT_ID:secret:claq-whatsapp-xxxxxxxx

# M-Pesa Vodacom Moçambique
MPESA_API_HOST=https://api.mpesa.vm.co.mz:18352
MPESA_SERVICE_PROVIDER_CODE=171717
MPESA_WEBHOOK_SECRET=your-mpesa-hmac-webhook-secret

# AWS Region
AWS_REGION=af-south-1

# API Gateway (production)
VITE_API_URL=https://wajcsa99fc.execute-api.af-south-1.amazonaws.com/v1
VITE_COGNITO_USER_POOL_ID=af-south-1_xxxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# CDK Deployment (optional)
CDK_DEFAULT_ACCOUNT=your-aws-account-id
CDK_DEFAULT_REGION=af-south-1
