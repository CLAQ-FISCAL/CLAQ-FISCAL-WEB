# ==============================================================================
# CLAQ FISCAL ALERT - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Server
NODE_ENV=production
PORT=4000
APP_URL=https://claq.co.mz
CORS_ORIGINS=https://claq.co.mz,http://localhost:5173

# Database (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql://claq_admin:claq_secure_password_2026@localhost:5432/claq_fiscal_alert?schema=public

# Redis & Background Queue (BullMQ)
REDIS_URL=redis://localhost:6379

# Security & Tokens
JWT_SECRET=claq_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
DIGITAL_SEAL_SECRET=claq_hmac_digital_seal_secret_2026_mz

# Meta WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=EAAxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000
WHATSAPP_WEBHOOK_VERIFY_TOKEN=claq_whatsapp_webhook_verify_token_2026

# Email Dispatcher (SendGrid / AWS SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxxxxxx
EMAIL_FROM=alertas@claq.co.mz
EMAIL_FROM_NAME="CLAQ Fiscal Alert"

# Mozambican Mobile Money & Payment Gateway (M-Pesa / E-Mola)
MPESA_API_KEY=xxxxxxxx
MPESA_PUBLIC_KEY=xxxxxxxx
MPESA_SERVICE_PROVIDER_CODE=171717
MPESA_INITIATOR_IDENTIFIER=claq_mpesa_api
MPESA_SECURITY_CREDENTIAL=xxxxxxxx

# AI Model Provider (Google Gemini / OpenAI)
GEMINI_API_KEY=AIzaxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxx

# AWS S3 / Cloudflare R2 Storage (Official PDF Certificates)
S3_BUCKET_NAME=claq-fiscal-documents
S3_REGION=af-south-1
S3_ACCESS_KEY_ID=AKIAxxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxx
S3_ENDPOINT=https://s3.af-south-1.amazonaws.com
