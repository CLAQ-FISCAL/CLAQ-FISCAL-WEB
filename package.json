{
  "name": "claq-fiscal-alert-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "CLAQ Fiscal Alert - Mozambican Tax Compliance & Intelligence Monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "npx concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend -- --host 127.0.0.1 --port 5173",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:lambdas": "npm run build:lambdas --workspace=backend",
    "test": "npm run test --workspace=backend",
    "lint": "npm run lint --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "deploy:demo": "npm run deploy:demo --workspace=backend",
    "deploy:prod": "npm run deploy:prod --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
